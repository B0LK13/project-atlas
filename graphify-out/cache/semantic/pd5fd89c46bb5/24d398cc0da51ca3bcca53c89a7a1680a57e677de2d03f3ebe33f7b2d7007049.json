{"nodes": [{"id": "docs_adr_adr_007_claim_identity_v2_canonicalization_adr007", "label": "ADR-007: Claim Identity v2 Canonicalization", "file_type": "document", "source_file": "docs/adr/ADR-007-claim-identity-v2-canonicalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_007_claim_identity_v2_canonicalization_canonical_identity_serialization", "label": "Canonical Identity Serialization (compact JSON array)", "file_type": "rationale", "source_file": "docs/adr/ADR-007-claim-identity-v2-canonicalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the pipe-delimited v2 key with json.dumps(..., separators=(\",\",\":\")) over a fixed-order array so embedded delimiters in any component cannot create colliding identity tuples (closes F-001)."}, {"id": "docs_adr_adr_007_claim_identity_v2_canonicalization_shared_rules_module", "label": "project_atlas.claim_identity shared rules module", "file_type": "concept", "source_file": "docs/adr/ADR-007-claim-identity-v2-canonicalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_007_claim_identity_v2_canonicalization_ambiguous_alias_invariant", "label": "Ambiguous Alias Invariant", "file_type": "rationale", "source_file": "docs/adr/ADR-007-claim-identity-v2-canonicalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A v1-to-v2 mapping is either resolved (aliases) or ambiguous, never both; multi-target mappings are placed only in the ambiguous collection (closes F-002)."}, {"id": "docs_adr_adr_007_claim_identity_v2_canonicalization_source_lineage_normalization", "label": "Source-Lineage CRLF-to-LF Normalization", "file_type": "rationale", "source_file": "docs/adr/ADR-007-claim-identity-v2-canonicalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discovery and validation normalize CRLF to LF for supported text extensions before computing the SHA-256 used for source identity, so checkout policy cannot change durable source identity across platforms."}], "edges": [{"source": "docs_adr_adr_007_claim_identity_v2_canonicalization_adr007", "target": "docs_adr_adr_007_claim_identity_v2_canonicalization_canonical_identity_serialization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-007-claim-identity-v2-canonicalization.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_007_claim_identity_v2_canonicalization_adr007", "target": "docs_adr_adr_007_claim_identity_v2_canonicalization_shared_rules_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-007-claim-identity-v2-canonicalization.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_007_claim_identity_v2_canonicalization_adr007", "target": "docs_adr_adr_007_claim_identity_v2_canonicalization_ambiguous_alias_invariant", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-007-claim-identity-v2-canonicalization.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_007_claim_identity_v2_canonicalization_adr007", "target": "docs_adr_adr_007_claim_identity_v2_canonicalization_source_lineage_normalization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-007-claim-identity-v2-canonicalization.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_007_claim_identity_v2_canonicalization_adr007", "target": "docs_evidence_as_core_003_v2_remediation_receipt_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_fi