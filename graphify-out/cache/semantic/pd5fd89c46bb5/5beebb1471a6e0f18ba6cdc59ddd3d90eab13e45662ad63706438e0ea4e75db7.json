{"nodes": [{"id": "docs_adr_adr_006_github_repository_governance_baseline_adr006", "label": "ADR-006: GitHub Repository Governance Baseline", "file_type": "document", "source_file": "docs/adr/ADR-006-github-repository-governance-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_006_github_repository_governance_baseline_governance_roles", "label": "Governance Roles and Separation of Duties", "file_type": "rationale", "source_file": "docs/adr/ADR-006-github-repository-governance-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separates Project Owner, Architecture Governor, Implementation Agent, Independent Verifier, Merge Operator, and Repository Administrator so no single actor both implements and certifies the same candidate."}, {"id": "docs_adr_adr_006_github_repository_governance_baseline_branch_model", "label": "Branch Model (main/architecture/feat/fix/evidence)", "file_type": "rationale", "source_file": "docs/adr/ADR-006-github-repository-governance-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "main is protected and the only release integration branch; a branch name is never sufficient integration authorization on its own."}, {"id": "docs_adr_adr_006_github_repository_governance_baseline_merge_model", "label": "Exact-Hash Fast-Forward Merge Policy", "file_type": "rationale", "source_file": "docs/adr/ADR-006-github-repository-governance-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GitHub rebase merging is rejected as normal policy because it rewrites the reviewed commit identity and can invalidate exact-hash evidence; merge/squash remain disabled."}, {"id": "docs_adr_adr_006_github_repository_governance_baseline_bootstrap_transition", "label": "AS-GH-001 Bootstrap Approval-Count Transition", "file_type": "rationale", "source_file": "docs/adr/ADR-006-github-repository-governance-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Temporarily reduces required approving reviews from 1 to 0 for the sole collaborator to break a self-approval merge lockout, with strict restoration criteria requiring a second trusted reviewer."}], "edges": [{"source": "docs_adr_adr_006_github_repository_governance_baseline_adr006", "target": "docs_adr_adr_006_github_repository_governance_baseline_governance_roles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-006-github-repository-governance-baseline.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_006_github_repository_governance_baseline_adr006", "target": "docs_adr_adr_006_github_repository_governance_baseline_branch_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-006-github-repository-governance-baseline.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_006_github_repository_governance_baseline_adr006", "target": "docs_adr_adr_006_github_repository_governance_baseline_merge_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-006-github-repository-governance-baseline.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_006_github_repository_governance_baseline_adr006", "target": "docs_adr_adr_006_github_repository_governance_baseline_bootstrap_transition", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/ADR-006-github-repository-governance-baseline.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_adr_006_github_repository_governance_baseline_adr006", "target": 