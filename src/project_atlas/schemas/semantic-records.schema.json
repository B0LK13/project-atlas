{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/semantic-records.schema.json",
  "title": "AS-CORE-002 semantic records",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "name", "generated", "sources", "coverage"],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "portfolio": { "type": ["string", "null"] },
    "lifecycle": { "type": "string" },
    "generated": { "type": "boolean" },
    "sources": { "type": "array" },
    "authority": { "type": "array" },
    "coverage": { "type": "array" },
    "concepts": { "type": "array" },
    "claims": { "type": "array" },
    "agent_events": { "type": "array" },
    "validations": { "type": "array" },
    "decisions": { "type": "array" },
    "relationships": { "type": "array" }
  }
}
