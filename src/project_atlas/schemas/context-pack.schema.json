{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/context-pack.schema.json",
  "title": "Context Pack Record",
  "description": "AS-2.0-CTX-001 fixture-safe context pack with mandatory provenance pointers. Never invents estate facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "compat_snapshot_id",
    "pack_id",
    "fixture_safe",
    "estate_facts_invented",
    "provenance_pointers",
    "authority",
    "truth_boundary",
    "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-CTX-001" },
    "compat_snapshot_id": { "const": "atlas-1.0.0-compat" },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "fixture_safe": { "const": true },
    "estate_facts_invented": { "const": false },
    "provenance_pointers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "kind"],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "receipt",
              "index",
              "claim",
              "concept",
              "other"
            ]
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry_id", "ref"],
        "properties": {
          "entry_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
          },
          "label": { "type": "string", "maxLength": 120 }
        }
      }
    },
    "notes": { "type": "string", "maxLength": 240 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": {
      "const": "CONTEXT PACK ≠ ESTATE FACTS / ≠ PILOT"
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
