{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/xproj-join-key.schema.json",
  "title": "XPROJ Join Key Record",
  "description": "AS-XPROJ-001 explicit join: (project_id, project_local_entity_id) → global_entity_id. Never name-merge. Evidence remains project-scoped.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "project_id",
    "project_local_entity_id",
    "global_entity_id",
    "evidence_refs",
    "authority",
    "status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-XPROJ-001" },
    "project_id": { "type": "string", "minLength": 1 },
    "project_local_entity_id": { "type": "string", "minLength": 1 },
    "global_entity_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "sha256"],
        "properties": {
          "relative_path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["joined", "quarantine_candidate"]
    },
    "truth_boundary": {
      "type": "string",
      "const": "CROSS-PROJECT IDENTITY ≠ AUTOMATIC AUTHORITY"
    }
  }
}
