{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/security-adv-matrix.schema.json",
  "title": "SecurityAdvMatrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
        "schema_version",
        "package_id",
        "compat_snapshot_id",
        "matrix_id",
        "matched_content_logged",
        "controls",
        "authority",
        "truth_boundary",
        "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-SEC-ADV-001" },
    "compat_snapshot_id": { "type": "string", "minLength": 1 },

    "matrix_id": { "type": "string" },
    "matched_content_logged": { "const": false },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control_id", "family", "status"],
        "properties": {
          "control_id": { "type": "string" },
          "family": {
            "type": "string",
            "enum": ["secrets", "path-safety", "quarantine", "receipt"]
          },
          "status": {
            "type": "string",
            "enum": ["present", "partial", "planned"]
          }
        }
      }
    },

    "authority": {
      "type": "object",
      "required": ["level", "note"],
      "additionalProperties": false,
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": { "type": "string" },
    "generated": {
      "type": "object",
      "required": ["by"],
      "additionalProperties": false,
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
