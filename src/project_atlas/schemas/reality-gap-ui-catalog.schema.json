{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/reality-gap-ui-catalog.schema.json",
  "title": "RealityGapUiCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
        "schema_version",
        "package_id",
        "compat_snapshot_id",
        "catalog_id",
        "canonical_writes",
        "panels",
        "authority",
        "truth_boundary",
        "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-REALITY-GAP-UI-001" },
    "compat_snapshot_id": { "type": "string", "minLength": 1 },

    "catalog_id": { "type": "string" },
    "canonical_writes": { "const": false },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["panel_id", "gap_id", "read_only"],
        "properties": {
          "panel_id": { "type": "string" },
          "gap_id": { "type": "string" },
          "read_only": { "const": true }
        }
      }
    },

    "authority": {
      "type": "object",
      "required": ["level", "note"],
      "additionalProperties": false,
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": { "type": "string" },
    "generated": {
      "type": "object",
      "required": ["by"],
      "additionalProperties": false,
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
