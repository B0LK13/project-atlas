{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/claim-validity-catalog.schema.json",
  "title": "Claim Validity Catalog",
  "description": "AS-2.0-TEMPORAL-001 deterministic catalog of claim validity windows. Does not rewrite AS-CORE-005 temporal evaluator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "compat_snapshot_id",
    "catalog_id",
    "windows",
    "window_count",
    "authority",
    "truth_boundary",
    "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-TEMPORAL-001" },
    "compat_snapshot_id": { "const": "atlas-1.0.0-compat" },
    "catalog_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "windows": {
      "type": "array",
      "items": {
        "$ref": "https://project-atlas.local/schemas/claim-validity-window.schema.json"
      }
    },
    "window_count": { "type": "integer", "minimum": 0 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": {
      "const": "VALIDITY CATALOG ≠ TEMPORAL EVALUATOR REWRITE"
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
