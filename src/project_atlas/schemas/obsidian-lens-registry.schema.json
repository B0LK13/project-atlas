{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/obsidian-lens-registry.schema.json",
  "title": "ObsidianLensRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "compat_snapshot_id",
    "registry_id",
    "plugin_shipped",
    "canonical_writes",
    "lenses",
    "authority",
    "truth_boundary",
    "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-OBS-UX-001" },
    "compat_snapshot_id": { "type": "string", "minLength": 1 },
    "registry_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "plugin_shipped": { "const": false },
    "canonical_writes": { "const": false },
    "lenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lens_id", "title", "read_only", "authority_level"],
        "properties": {
          "lens_id": { "type": "string" },
          "title": { "type": "string" },
          "read_only": { "const": true },
          "authority_level": { "const": "derived" },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "authority": {
      "type": "object",
      "required": ["level", "note"],
      "additionalProperties": false,
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": { "type": "string" },
    "generated": {
      "type": "object",
      "required": ["by"],
      "additionalProperties": false,
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
