{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/reality-gap-inventory.schema.json",
  "title": "Reality Gap Inventory",
  "description": "AS-2.0-REALITY-GAP-001 fixture-only inventory of 1.0→2.0 reality gaps from REALITY-GAP.md. Never invents estate/PILOT roots.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "compat_snapshot_id",
    "source_doc",
    "pilot_roots",
    "authentic_estate_pilot_passed",
    "scenarios",
    "scenario_count",
    "authority",
    "truth_boundary",
    "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-REALITY-GAP-001" },
    "compat_snapshot_id": { "const": "atlas-1.0.0-compat" },
    "source_doc": { "const": "docs/atlas-2.0/REALITY-GAP.md" },
    "pilot_roots": { "const": 0 },
    "authentic_estate_pilot_passed": { "type": "boolean" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gap_id",
          "title",
          "one_dot_oh_today",
          "two_dot_oh_aspiration",
          "blocker",
          "status",
          "evidence_class",
          "authentic_estate",
          "invent_pilot_roots"
        ],
        "properties": {
          "gap_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "one_dot_oh_today": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "two_dot_oh_aspiration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "blocker": { "type": "string", "minLength": 1, "maxLength": 240 },
          "status": {
            "enum": [
              "open",
              "partially-addressed",
              "blocked-pilot",
              "blocked-freeze",
              "addressed-fixture-only"
            ]
          },
          "evidence_class": { "const": "fixture-only" },
          "authentic_estate": { "const": false },
          "invent_pilot_roots": { "const": false },
          "notes": { "type": "string", "maxLength": 240 }
        }
      }
    },
    "scenario_count": { "type": "integer", "minimum": 1 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": {
      "const": "REALITY-GAP FIXTURE ≠ PILOT PASS / ≠ WEB ACCEPTED / ≠ 2.0 RELEASE"
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
