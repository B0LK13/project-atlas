{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/knowledge-inbox-receipt.schema.json",
  "title": "KnowledgeInboxReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
        "schema_version",
        "package_id",
        "compat_snapshot_id",
        "receipt_id",
        "status",
        "promoted_to_authority",
        "item_count",
        "authority",
        "truth_boundary",
        "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-INBOX-001" },
    "compat_snapshot_id": { "type": "string", "minLength": 1 },

    "receipt_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["quarantined", "accepted-review", "rejected"]
    },
    "promoted_to_authority": { "const": false },
    "item_count": { "type": "integer", "minimum": 0 },

    "authority": {
      "type": "object",
      "required": ["level", "note"],
      "additionalProperties": false,
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": { "type": "string" },
    "generated": {
      "type": "object",
      "required": ["by"],
      "additionalProperties": false,
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
