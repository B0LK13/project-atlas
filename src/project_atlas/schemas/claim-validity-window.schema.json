{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/claim-validity-window.schema.json",
  "title": "Claim Validity Window",
  "description": "AS-2.0-TEMPORAL-001 valid-time window for an immutable claim. Deepens AS-CORE-005; never mutates Claim Identity; never invents wall-clock now.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "compat_snapshot_id",
    "claim_id",
    "valid_from",
    "knowledge_compilation_id",
    "evidence_kind",
    "rationale",
    "authority",
    "truth_boundary",
    "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-TEMPORAL-001" },
    "compat_snapshot_id": { "const": "atlas-1.0.0-compat" },
    "claim_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "valid_from": {
      "type": "string",
      "minLength": 4,
      "maxLength": 64
    },
    "valid_to": {
      "type": "string",
      "minLength": 4,
      "maxLength": 64
    },
    "knowledge_compilation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "evidence_kind": {
      "enum": [
        "semantic-event",
        "document-declared",
        "source-version",
        "unknown"
      ]
    },
    "core005_temporal_status": {
      "enum": [
        "current",
        "historical",
        "unresolved",
        "authority-pending"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": {
      "const": "VALIDITY WINDOW ≠ AUTHORITY / ≠ CLAIM IDENTITY MUTATION"
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
