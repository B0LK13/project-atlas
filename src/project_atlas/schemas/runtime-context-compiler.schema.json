{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/runtime-context-compiler.schema.json",
  "title": "AS-2.2 Runtime Context Compiler Package",
  "description": "AS-2.2-RUNTIME-001 budgeted context package. Derived-only; empty provenance preserved honestly (never invent sources); no LLM authority; no Layer B writes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "artifact_kind",
    "compat_snapshot_id",
    "pack_id",
    "profile_id",
    "budget",
    "entries",
    "entry_count",
    "truncated",
    "input_hygiene",
    "pipeline",
    "authority",
    "truth_boundary",
    "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.2-RUNTIME-001" },
    "artifact_kind": { "const": "runtime-context-compiler" },
    "compat_snapshot_id": { "const": "atlas-1.0.0-compat" },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "profile_id": { "const": "p0-readonly" },
    "budget": { "type": "integer", "minimum": 1, "maximum": 100 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "record_type",
          "record_id",
          "slot",
          "authority_level",
          "provenance"
        ],
        "properties": {
          "entry_id": { "type": "string", "minLength": 1 },
          "record_type": { "type": "string", "minLength": 1 },
          "record_id": { "type": "string", "minLength": 1 },
          "slot": { "type": "string" },
          "authority_level": { "const": "derived" },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "ref"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "source",
                    "receipt",
                    "index",
                    "claim",
                    "concept",
                    "other"
                  ]
                },
                "ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
                }
              }
            }
          }
        }
      }
    },
    "entry_count": { "type": "integer", "minimum": 0 },
    "truncated": { "type": "boolean" },
    "input_hygiene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skipped_malformed",
        "duplicates_collapsed",
        "provenance_elems_dropped",
        "empty_provenance_policy"
      ],
      "properties": {
        "skipped_malformed": { "type": "integer", "minimum": 0 },
        "duplicates_collapsed": { "type": "integer", "minimum": 0 },
        "provenance_elems_dropped": { "type": "integer", "minimum": 0 },
        "empty_provenance_policy": { "const": "refuse" }
      }
    },
    "pipeline": {
      "type": "array",
      "const": [
        "candidates",
        "vault_presence",
        "provenance_gate",
        "authority_stamp",
        "budget",
        "package"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "llm_authority",
        "pilot",
        "estate_facts_invented",
        "candidates_caller_supplied"
      ],
      "properties": {
        "level": { "const": "derived" },
        "llm_authority": { "const": false },
        "pilot": { "const": false },
        "estate_facts_invented": { "const": false },
        "candidates_caller_supplied": { "const": true }
      }
    },
    "truth_boundary": {
      "const": "CONTEXT COMPILER ≠ ESTATE FACTS / ≠ PILOT / ≠ LLM AUTHORITY"
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": { "by": { "const": "project-atlas" } }
    },
    "output_path": {
      "type": "string",
      "pattern": "^generated/context-compiler/[a-z][a-z0-9-]{0,63}-context-compiler\\.json$"
    }
  }
}
