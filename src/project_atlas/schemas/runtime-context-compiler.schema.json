{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/runtime-context-compiler.schema.json",
  "title": "AS-2.2 Runtime Context Compiler Package",
  "description": "AS-2.2-RUNTIME-001 budgeted context package (P0/P2). Derived-only; empty provenance refused; no LLM authority; no Layer B writes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "artifact_kind",
    "compat_snapshot_id",
    "pack_id",
    "project_id",
    "profile_id",
    "budget",
    "entries",
    "entry_count",
    "truncated",
    "input_hygiene",
    "pipeline",
    "authority",
    "truth_boundary",
    "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.2-RUNTIME-001" },
    "artifact_kind": { "const": "runtime-context-compiler" },
    "compat_snapshot_id": { "const": "atlas-1.0.0-compat" },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "project_id": { "type": "string", "minLength": 1 },
    "profile_id": {
      "type": "string",
      "enum": ["p0-readonly", "p2-readonly"]
    },
    "budget": { "type": "integer", "minimum": 1, "maximum": 100 },
    "on_overflow": { "type": "string", "enum": ["truncate", "fail"] },
    "include_unresolved_conflicts": { "type": "boolean" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "record_type",
          "record_id",
          "slot",
          "authority_level",
          "provenance"
        ],
        "properties": {
          "entry_id": { "type": "string", "minLength": 1 },
          "record_type": { "type": "string", "minLength": 1 },
          "record_id": { "type": "string", "minLength": 1 },
          "slot": { "type": "string" },
          "authority_level": {
            "type": "string",
            "enum": [
              "primary",
              "validated-execution",
              "maintained",
              "derived",
              "generated",
              "inferred",
              "pending",
              "conflicting",
              "rejected"
            ]
          },
          "freshness": {
            "type": "string",
            "enum": ["fresh", "stale", "unknown"]
          },
          "conflict_state": {
            "type": "string",
            "enum": ["none", "unresolved", "excluded"]
          },
          "conflict_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reason_included": {
            "type": "string",
            "enum": [
              "task-match",
              "profile-prefer",
              "authority-primary",
              "authority-validated",
              "authority-maintained",
              "freshness-current",
              "conflict-sidecar",
              "budget-retained",
              "explicit-candidate"
            ]
          },
          "relevance_rank": { "type": "integer", "minimum": 0 },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "ref"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "source",
                    "receipt",
                    "index",
                    "claim",
                    "concept",
                    "other"
                  ]
                },
                "ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
                }
              }
            }
          }
        }
      }
    },
    "entry_count": { "type": "integer", "minimum": 0 },
    "truncated": { "type": "boolean" },
    "input_hygiene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skipped_malformed",
        "duplicates_collapsed",
        "provenance_elems_dropped",
        "empty_provenance_policy"
      ],
      "properties": {
        "skipped_malformed": { "type": "integer", "minimum": 0 },
        "duplicates_collapsed": { "type": "integer", "minimum": 0 },
        "provenance_elems_dropped": { "type": "integer", "minimum": 0 },
        "empty_provenance_policy": { "const": "refuse" }
      }
    },
    "pipeline": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 6
    },
    "pipeline_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidates_in",
        "items_out",
        "truncated",
        "overflow",
        "unresolved_conflicts_retained",
        "conflicts_excluded",
        "freshness_unknown_count"
      ],
      "properties": {
        "candidates_in": { "type": "integer", "minimum": 0 },
        "items_out": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "overflow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["occurred", "dropped_count", "policy"],
          "properties": {
            "occurred": { "type": "boolean" },
            "dropped_count": { "type": "integer", "minimum": 0 },
            "policy": { "type": "string", "enum": ["truncate", "fail", "none"] }
          }
        },
        "unresolved_conflicts_retained": { "type": "integer", "minimum": 0 },
        "conflicts_excluded": { "type": "integer", "minimum": 0 },
        "freshness_unknown_count": { "type": "integer", "minimum": 0 },
        "excluded_conflict_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "excluded_conflicts_detail": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conflict_id",
              "claim_ids",
              "subject",
              "field",
              "excluded_claim_id"
            ],
            "properties": {
              "conflict_id": { "type": "string", "minLength": 1 },
              "claim_ids": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "subject": { "type": "string" },
              "field": { "type": "string" },
              "excluded_claim_id": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "llm_authority",
        "pilot",
        "estate_facts_invented",
        "candidates_caller_supplied"
      ],
      "properties": {
        "level": { "const": "derived" },
        "llm_authority": { "const": false },
        "pilot": { "const": false },
        "estate_facts_invented": { "const": false },
        "candidates_caller_supplied": { "const": true }
      }
    },
    "truth_boundary": {
      "const": "CONTEXT COMPILER ≠ ESTATE FACTS / ≠ PILOT / ≠ LLM AUTHORITY"
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": { "by": { "const": "project-atlas" } }
    },
    "output_path": {
      "type": "string",
      "pattern": "^generated/context-compiler/[a-z][a-z0-9-]{0,63}-context-compiler\\.json$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "profile_id": { "const": "p0-readonly" } } },
      "then": {
        "properties": {
          "pipeline": {
            "const": [
              "candidates",
              "vault_presence",
              "provenance_gate",
              "authority_stamp",
              "budget",
              "package"
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "profile_id": { "const": "p2-readonly" } } },
      "then": {
        "required": [
          "on_overflow",
          "include_unresolved_conflicts",
          "pipeline_receipt"
        ],
        "properties": {
          "pipeline": {
            "const": [
              "candidates",
              "vault_presence",
              "provenance_gate",
              "authority",
              "freshness",
              "conflicts",
              "relevance",
              "budget",
              "package"
            ]
          }
        }
      }
    }
  ]
}
