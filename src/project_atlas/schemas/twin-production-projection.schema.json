{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/twin-production-projection.schema.json",
  "title": "TwinProductionProjection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "compat_snapshot_id",
    "projection_id",
    "pilot_mode",
    "authentic_estate_pilot",
    "owner_waived",
    "honest_label",
    "twin_production_ready",
    "estate_pilot_passed",
    "projects",
    "authority",
    "truth_boundary",
    "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-TWIN-001" },
    "compat_snapshot_id": { "type": "string" },
    "projection_id": { "type": "string" },
    "pilot_mode": { "const": "FIXTURE_ONLY_OWNER_WAIVER" },
    "authentic_estate_pilot": { "const": false },
    "owner_waived": { "const": true },
    "honest_label": { "type": "string" },
    "twin_production_ready": { "const": true },
    "estate_pilot_passed": { "const": false },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_id", "display_name", "health", "evidence_class"],
        "properties": {
          "project_id": { "type": "string" },
          "display_name": { "type": "string" },
          "health": {
            "type": "string",
            "enum": ["unknown", "degraded", "healthy"]
          },
          "evidence_class": { "const": "fixture" }
        }
      }
    },
    "authority": {
      "type": "object",
      "required": ["level", "note"],
      "additionalProperties": false,
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": { "type": "string" },
    "generated": {
      "type": "object",
      "required": ["by"],
      "additionalProperties": false,
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}