{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/sync-receipts-dry-run.schema.json",
  "title": "Sync Estate Receipts Dry-Run (SYNC-004 scaffold)",
  "description": "Deterministic, inert estate-receipt and trigger stubs from an explicit AS-SYNC-003 dry-run queue. Never production certified and never an estate PILOT pass.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema", "truth_plane", "authority_plane", "note", "package", "production_sync_certified", "estate_pilot_passed", "registry_id", "vault_identity", "source_queue_package", "estate_receipts", "triggers", "generated"],
  "properties": {
    "schema_version": {"const": 1},
    "schema": {"const": "atlas.sync_receipts.dry_run.v1"},
    "truth_plane": {"const": "operational"},
    "authority_plane": {"const": "none"},
    "note": {"const": "DRY-RUN ESTATE RECEIPT/TRIGGER STUBS - NOT SYNC CERT / NOT PILOT PASS"},
    "package": {"const": "AS-SYNC-004-SCAFFOLD"},
    "production_sync_certified": {"const": false},
    "estate_pilot_passed": {"const": false},
    "registry_id": {"type": "string", "minLength": 1},
    "vault_identity": {"type": "string", "minLength": 1},
    "source_queue_package": {"const": "AS-SYNC-003-SCAFFOLD"},
    "estate_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["queue_index", "project_uuid", "receipt_id", "status", "evidence_hash"],
        "properties": {
          "queue_index": {"type": "integer", "minimum": 0},
          "project_uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
          "receipt_id": {"type": "null"},
          "status": {"const": "not_issued"},
          "evidence_hash": {"type": "null"}
        }
      }
    },
    "triggers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["queue_index", "project_uuid", "trigger_type", "enabled", "registration_id", "expression"],
        "properties": {
          "queue_index": {"type": "integer", "minimum": 0},
          "project_uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
          "trigger_type": {"enum": ["on_change", "on_schedule"]},
          "enabled": {"const": false},
          "registration_id": {"type": "null"},
          "expression": {"type": "null"}
        }
      }
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": {"by": {"const": "atlas-sync-004-scaffold"}}
    }
  }
}
