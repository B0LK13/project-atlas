{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/twin-fixture-scenario.schema.json",
  "title": "TwinFixtureScenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
        "schema_version",
        "package_id",
        "compat_snapshot_id",
        "scenario_id",
        "estate_pilot_passed",
        "twin_production_ready",
        "steps",
        "authority",
        "truth_boundary",
        "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-TWIN-FIXTURE-002" },
    "compat_snapshot_id": { "type": "string", "minLength": 1 },

    "scenario_id": { "type": "string" },
    "estate_pilot_passed": { "const": false },
    "twin_production_ready": { "const": false },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "action", "evidence_class"],
        "properties": {
          "step_id": { "type": "string" },
          "action": { "type": "string" },
          "evidence_class": { "const": "fixture" }
        }
      }
    },

    "authority": {
      "type": "object",
      "required": ["level", "note"],
      "additionalProperties": false,
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": { "type": "string" },
    "generated": {
      "type": "object",
      "required": ["by"],
      "additionalProperties": false,
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
