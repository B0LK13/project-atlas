{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/project-roadmap.schema.json",
  "title": "ProjectRoadmap",
  "description": "AS-PROJECT-ROADMAP-001 derived Living Project Roadmap V1 (≠ canonical truth)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema",
    "package",
    "answer_id",
    "project_id",
    "status",
    "you_are_here",
    "items",
    "blockers",
    "critical_path",
    "next_unlock",
    "unknowns",
    "honesty"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "schema": { "const": "atlas.project-roadmap.v1" },
    "package": { "const": "AS-PROJECT-ROADMAP-001" },
    "answer_id": { "type": "string", "minLength": 1 },
    "subject": { "type": "string" },
    "field": { "const": "roadmap" },
    "title": { "type": "string" },
    "summary": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["derived", "unknown"] },
    "authority": { "const": "derived-lens" },
    "layer": { "const": "C" },
    "project_id": { "type": "string", "minLength": 1 },
    "you_are_here": { "type": "object" },
    "milestones": { "type": "array", "items": { "type": "object" } },
    "items": { "type": "array", "items": { "type": "object" } },
    "blockers": { "type": "array", "items": { "type": "object" } },
    "critical_path": { "type": "array", "items": { "type": "string" } },
    "next_unlock": { "type": "object" },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "pending_reviews": { "type": "integer", "minimum": 0 },
    "unresolved_conflicts": { "type": "integer", "minimum": 0 },
    "inspected_artifacts": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } },
    "generated": { "type": "object" },
    "honesty": {
      "type": "object",
      "required": [
        "roadmap_is_canonical",
        "derived_status_is_authority",
        "percent_complete_is_canonical"
      ],
      "properties": {
        "roadmap_is_canonical": { "const": false },
        "derived_status_is_authority": { "const": false },
        "ui_is_canonical": { "const": false },
        "unknown_is_valid": { "const": true },
        "percent_complete_is_canonical": { "const": false },
        "cyclic_dependencies": { "type": "boolean" },
        "authentic_pilot": { "type": "boolean" },
        "atlas_opt_wake_gate": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
