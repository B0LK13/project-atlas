{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/xproj-global-edge.schema.json",
  "title": "XPROJ Global Edge Record",
  "description": "AS-XPROJ-002 explicit cross-project edge between registered global entities. CROSS-PROJECT EDGE ≠ AUTOMATIC AUTHORITY. Endpoints are global_entity_id only — never display-name merge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "edge_id",
    "relationship_type",
    "source_global_entity_id",
    "target_global_entity_id",
    "link_quality",
    "edge_fingerprint",
    "evidence_refs",
    "authority",
    "status",
    "registration_kind",
    "truth_boundary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-XPROJ-002" },
    "edge_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "relationship_type": {
      "type": "string",
      "enum": [
        "part-of",
        "depends-on",
        "documents",
        "validates",
        "supersedes",
        "derived-from",
        "conflicts-with",
        "extension"
      ]
    },
    "extension_type": { "type": "string", "minLength": 1 },
    "source_global_entity_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "target_global_entity_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "link_quality": {
      "type": "string",
      "enum": ["verified", "supported", "inferred"]
    },
    "edge_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "sha256"],
        "properties": {
          "relative_path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "source_project_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "target_project_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "registration_kind": { "const": "explicit" },
    "status": { "const": "registered" },
    "truth_boundary": {
      "type": "string",
      "const": "CROSS-PROJECT EDGE ≠ AUTOMATIC AUTHORITY"
    },
    "notes": { "type": "string", "maxLength": 240 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "relationship_type": { "const": "extension" } }
      },
      "then": { "required": ["extension_type"] },
      "else": { "not": { "required": ["extension_type"] } }
    }
  ]
}
