{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/autonomy-trusted-anchor.schema.json",
  "title": "AutonomyTrustedAnchor",
  "description": "AS-ORCH-AUTONOMY-001-PIN-RETARGET trusted runtime anchor. Record identity is not owner authority. Compile-time bootstrap pins are not runtime authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_identity",
    "trusted_main",
    "trusted_tree",
    "predecessor_main",
    "predecessor_tree",
    "advancement_reason",
    "source_package",
    "source_directive",
    "source_pr",
    "merge_commit",
    "merge_parent_1",
    "merge_parent_2",
    "merge_tree",
    "certified_head",
    "certified_tree",
    "certification_status",
    "independent_verification_status",
    "post_merge_seal",
    "post_merge_ci",
    "evidence_reference",
    "evidence_digest",
    "sequence",
    "record_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "repository_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
    },
    "trusted_main": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "trusted_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "predecessor_main": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "predecessor_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "advancement_reason": { "const": "VERIFIED_OWNER_AUTHORIZED_MERGE" },
    "source_package": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_directive": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_pr": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "merge_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "merge_parent_1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "merge_parent_2": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "merge_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "certified_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "certified_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "certification_status": { "const": "CERTIFIED" },
    "independent_verification_status": { "const": "PASS" },
    "post_merge_seal": { "const": "PASS" },
    "post_merge_ci": { "const": "PASS" },
    "evidence_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
    },
    "evidence_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "record_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
