{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/agent-eval-shadow-receipt.schema.json",
  "title": "AgentEvalShadowReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
        "schema_version",
        "package_id",
        "compat_snapshot_id",
        "receipt_id",
        "mode",
        "authority_promoted",
        "score_subjective",
        "cases_run",
        "authority",
        "truth_boundary",
        "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-AGENT-EVAL-001" },
    "compat_snapshot_id": { "type": "string", "minLength": 1 },

    "receipt_id": { "type": "string" },
    "mode": { "const": "shadow" },
    "authority_promoted": { "const": false },
    "score_subjective": { "const": false },
    "cases_run": { "type": "integer", "minimum": 0 },

    "authority": {
      "type": "object",
      "required": ["level", "note"],
      "additionalProperties": false,
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": { "type": "string" },
    "generated": {
      "type": "object",
      "required": ["by"],
      "additionalProperties": false,
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
