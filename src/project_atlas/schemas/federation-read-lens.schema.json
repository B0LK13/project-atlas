{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/federation-read-lens.schema.json",
  "title": "FederationReadLens",
  "type": "object",
  "additionalProperties": false,
  "required": [
        "schema_version",
        "package_id",
        "compat_snapshot_id",
        "lens_id",
        "federation_id",
        "cross_vault_promote",
        "members_visible",
        "authority",
        "truth_boundary",
        "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-FED-002" },
    "compat_snapshot_id": { "type": "string", "minLength": 1 },

    "lens_id": { "type": "string" },
    "federation_id": { "type": "string" },
    "cross_vault_promote": { "const": false },
    "members_visible": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },

    "authority": {
      "type": "object",
      "required": ["level", "note"],
      "additionalProperties": false,
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": { "type": "string" },
    "generated": {
      "type": "object",
      "required": ["by"],
      "additionalProperties": false,
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
