{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/knowledge-ci-harness.schema.json",
  "title": "KnowledgeCiHarness",
  "type": "object",
  "additionalProperties": false,
  "required": [
        "schema_version",
        "package_id",
        "compat_snapshot_id",
        "harness_id",
        "authority_promoted",
        "gates",
        "authority",
        "truth_boundary",
        "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-KCI-HARNESS-001" },
    "compat_snapshot_id": { "type": "string", "minLength": 1 },

    "harness_id": { "type": "string" },
    "authority_promoted": { "const": false },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "kind", "required"],
        "properties": {
          "gate_id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["schema", "pytest", "ruff", "mypy", "compat"]
          },
          "required": { "type": "boolean" }
        }
      }
    },

    "authority": {
      "type": "object",
      "required": ["level", "note"],
      "additionalProperties": false,
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": { "type": "string" },
    "generated": {
      "type": "object",
      "required": ["by"],
      "additionalProperties": false,
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
