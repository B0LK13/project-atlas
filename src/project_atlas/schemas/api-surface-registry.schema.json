{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/api-surface-registry.schema.json",
  "title": "ApiSurfaceRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": [
        "schema_version",
        "package_id",
        "compat_snapshot_id",
        "registry_id",
        "surfaces",
        "write_enabled",
        "authority",
        "truth_boundary",
        "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-API-001" },
    "compat_snapshot_id": { "type": "string", "minLength": 1 },

    "registry_id": { "type": "string" },
    "write_enabled": { "const": false },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface_id", "route_class", "enabled"],
        "properties": {
          "surface_id": { "type": "string" },
          "route_class": {
            "type": "string",
            "enum": ["health", "projects", "knowledge", "graph", "ops"]
          },
          "enabled": { "type": "boolean" }
        }
      }
    },

    "authority": {
      "type": "object",
      "required": ["level", "note"],
      "additionalProperties": false,
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": { "type": "string" },
    "generated": {
      "type": "object",
      "required": ["by"],
      "additionalProperties": false,
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
