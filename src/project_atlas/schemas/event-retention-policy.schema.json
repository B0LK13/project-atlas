{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/event-retention-policy.schema.json",
  "title": "Event Package / Receipt Retention Policy",
  "description": "AS-INT-009 retention caps for sources/agent-events and receipts/agent-events. Operational only; never authority. Count/size caps only — no wall-clock freshness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema",
    "truth_plane",
    "authority_plane",
    "note",
    "max_packages",
    "max_bytes",
    "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "schema": { "const": "atlas.event_retention.policy.v1" },
    "truth_plane": { "const": "operational" },
    "authority_plane": { "const": "none" },
    "note": {
      "const": "RAW PACKAGE / RECEIPT RETENTION ≠ PROJECT AUTHORITY"
    },
    "max_packages": { "type": "integer", "minimum": 1 },
    "max_bytes": { "type": "integer", "minimum": 1024 },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": {
        "by": { "type": "string", "minLength": 1 }
      }
    }
  }
}
