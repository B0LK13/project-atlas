{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/bitemporal-as-of-result.schema.json",
  "title": "Bitemporal As-Of Result",
  "description": "AS-2.0-TEMPORAL-001 fail-closed as-of selection over claim validity windows. Prefer unresolved over wrong current. Never uses wall-clock now.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "compat_snapshot_id",
    "subject",
    "field",
    "as_of_valid_time",
    "status",
    "selected_claim_id",
    "candidate_claim_ids",
    "rationale",
    "authority",
    "truth_boundary",
    "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-TEMPORAL-001" },
    "compat_snapshot_id": { "const": "atlas-1.0.0-compat" },
    "subject": { "type": "string", "minLength": 1, "maxLength": 240 },
    "field": { "type": "string", "minLength": 1, "maxLength": 128 },
    "as_of_valid_time": { "type": "string", "minLength": 4, "maxLength": 64 },
    "status": {
      "enum": [
        "selected",
        "not_found",
        "unresolved_overlap",
        "unresolved_incomplete",
        "rejected_malformed"
      ]
    },
    "selected_claim_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "candidate_claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 240 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": {
      "const": "AS-OF RESULT ≠ AUTHORITY / ≠ WALL-CLOCK NOW"
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
