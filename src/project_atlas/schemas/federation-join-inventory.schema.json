{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/federation-join-inventory.schema.json",
  "title": "Federation Join Inventory",
  "description": "AS-2.0-FED-001 operator-declared multi-vault join inventory. Consume-only; no cross-vault promote; 1.0 wins conflicts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "compat_snapshot_id",
    "federation_id",
    "members",
    "status",
    "authority",
    "truth_boundary",
    "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-FED-001" },
    "compat_snapshot_id": { "const": "atlas-1.0.0-compat" },
    "federation_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member_id", "vault_root", "role"],
        "properties": {
          "member_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "vault_root": { "type": "string", "minLength": 1 },
          "role": { "enum": ["primary", "member"] },
          "project_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        }
      }
    },
    "status": { "enum": ["joined", "refused"] },
    "refusal_reason": { "type": "string", "maxLength": 240 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": {
      "const": "FEDERATION JOIN ≠ CROSS-VAULT AUTHORITY"
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
