{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/autonomy-lease.schema.json",
  "title": "AutonomyAgentLease",
  "description": "AS-ORCH-AUTONOMY-001 agent lease. LEASE != DISPATCH. Scope expansion is forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lease_id",
    "agent_id",
    "package_id",
    "branch",
    "worktree",
    "base_pin",
    "authorized_paths",
    "forbidden_paths",
    "capabilities",
    "start_state",
    "expected_output",
    "expiry_or_terminal_condition",
    "active",
    "sequence"
  ],
  "properties": {
    "lease_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "agent_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "package_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "branch": { "type": "string", "minLength": 1, "maxLength": 256 },
    "worktree": { "type": "string", "minLength": 1, "maxLength": 256 },
    "base_pin": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "authorized_paths": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$" }
    },
    "forbidden_paths": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$" }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "enum": ["DISCOVER", "IMPLEMENT", "VERIFY", "REMEDIATE", "ADVERSARIAL_REVIEW"] }
    },
    "start_state": {
      "enum": [
        "DISCOVERED", "READY", "LEASED", "ACTIVE", "VERIFYING", "REMEDIATING",
        "CERTIFIED", "OWNER_HELD", "MERGE_ELIGIBLE", "MERGED", "BLOCKED",
        "SUPERSEDED", "CLOSED"
      ]
    },
    "expected_output": { "type": "string", "minLength": 1, "maxLength": 256 },
    "expiry_or_terminal_condition": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
    "active": { "type": "boolean" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 1000000 }
  }
}
