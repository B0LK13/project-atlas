{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/context-pack-composition.schema.json",
  "title": "ContextPackComposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","package_id","compat_snapshot_id","composition_id","pack_id","estate_facts_invented","layers","authority","truth_boundary","generated"],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"const": "AS-2.0-CTX-002"},
    "compat_snapshot_id": {"type": "string"},
    "composition_id": {"type": "string"},
    "pack_id": {"type": "string"},
    "estate_facts_invented": {"const": false},
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer_id","role","provenance_required"],
        "properties": {
          "layer_id": {"type": "string"},
          "role": {"type": "string", "enum": ["evidence","derived","operator"]},
          "provenance_required": {"type": "boolean"}
        }
      }
    },
    "authority": {
      "type": "object",
      "required": ["level","note"],
      "additionalProperties": false,
      "properties": {"level": {"const": "derived"}, "note": {"type": "string"}}
    },
    "truth_boundary": {"type": "string"},
    "generated": {"type": "object", "required": ["by"], "additionalProperties": false, "properties": {"by": {"const": "project-atlas"}}}
  }
}
