{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/web-surface-catalog.schema.json",
  "title": "WebSurfaceCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
        "schema_version",
        "package_id",
        "compat_snapshot_id",
        "catalog_id",
        "ui_rewrite",
        "surfaces",
        "authority",
        "truth_boundary",
        "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-WEB-SURFACE-001" },
    "compat_snapshot_id": { "type": "string", "minLength": 1 },

    "catalog_id": { "type": "string" },
    "ui_rewrite": { "const": false },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface_id", "kind", "read_only", "estate_live"],
        "properties": {
          "surface_id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["ask-atlas", "twin-ui", "canvas", "timeline"]
          },
          "read_only": { "const": true },
          "estate_live": { "const": false }
        }
      }
    },

    "authority": {
      "type": "object",
      "required": ["level", "note"],
      "additionalProperties": false,
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": { "type": "string" },
    "generated": {
      "type": "object",
      "required": ["by"],
      "additionalProperties": false,
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
