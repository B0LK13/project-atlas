{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/dispatch-record.schema.json",
  "title": "DispatchRecord",
  "description": "AS-ORCH-001D persisted single-hop dispatch identity. PROCESS_DISPATCH != PRIVILEGED EXECUTION AUTHORITY. DISPATCH_RECORD != AUTHORITY. additionalProperties:false fails closed against executable payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "dispatch_id",
    "status",
    "source_route_digest",
    "source_task_id",
    "dispatch_task_id",
    "target_role",
    "task_type",
    "attempt",
    "workspace_root",
    "process_started",
    "process_terminal",
    "process_timeout",
    "result_received",
    "source_acknowledged",
    "result_staged",
    "execution_authorized"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-ORCH-001D" },
    "dispatch_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": {
      "enum": [
        "prepared",
        "running",
        "result_received",
        "finalizing",
        "completed",
        "failed",
        "OWNER_REQUIRED",
        "TERMINAL",
        "REJECTED"
      ]
    },
    "source_route_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "dispatch_task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "target_role": { "enum": ["local", "integration", "autonomous"] },
    "task_type": {
      "enum": [
        "candidate_verification",
        "recertification",
        "program_reconciliation",
        "remediation"
      ]
    },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "workspace_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "process_started": { "type": "boolean" },
    "process_terminal": { "type": "boolean" },
    "process_timeout": { "type": "boolean" },
    "process_exit_code": {
      "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": -1, "maximum": 1000000 }]
    },
    "result_received": { "type": "boolean" },
    "source_acknowledged": { "type": "boolean" },
    "result_staged": { "type": "boolean" },
    "stdout_digest": {
      "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }]
    },
    "stderr_digest": {
      "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }]
    },
    "result_text_digest": {
      "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }]
    },
    "session_id": {
      "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 128 }]
    },
    "request_id": {
      "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 128 }]
    },
    "duration_ms": {
      "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0, "maximum": 86400000 }]
    },
    "failure_code": {
      "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 64 }]
    },
    "managed_session_id": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      ]
    },
    "target_receipt_id": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      ]
    },
    "target_receipt_verified": { "type": "boolean" },
    "target_receipt_binding_digest": {
      "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }]
    },
    "raw_target_result_digest": {
      "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }]
    },
    "normalized_target_result_digest": {
      "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }]
    },
    "execution_authorized": { "const": false }
  }
}
