{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/claim-lifecycle.schema.json",
  "title": "ClaimLifecycleRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "project_id", "lifecycle", "content_sha256", "source_ids", "previous_source_ids", "observation_count", "transitions"],
  "properties": {
    "schema_version": { "const": 1 },
    "claim_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "project_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "content_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "source_ids": { "type": "array", "items": { "type": "string" } },
    "source_lineage_ids": { "type": "array", "items": { "type": "string", "pattern": "^sline-[A-Za-z0-9]+$" } },
    "previous_content_sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" },
    "previous_source_ids": { "type": "array", "items": { "type": "string" } },
    "predecessor_claim_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "superseded_by_claim_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "last_observed_at": { "type": ["string", "null"], "format": "date-time" },
    "observation_count": { "type": "integer", "minimum": 1 },
    "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
    "rejection_reason": { "type": ["string", "null"] }
  },
  "$defs": {
    "lifecycle": { "type": "string", "enum": ["new", "unchanged", "updated", "superseded", "contradicted", "stale", "removed-source", "restored", "rejected"] },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_state", "new_state", "reason", "reference_ids"],
      "properties": {
        "previous_state": { "$ref": "#/$defs/lifecycle" },
        "new_state": { "$ref": "#/$defs/lifecycle" },
        "reason": { "type": "string", "minLength": 1 },
        "reference_ids": { "type": "array", "items": { "type": "string" } },
        "transition_at": { "type": ["string", "null"], "format": "date-time" },
        "previous_content_sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" },
        "new_content_sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" },
        "related_conflict_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "superseded_by_claim_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
      }
    }
  }
}
