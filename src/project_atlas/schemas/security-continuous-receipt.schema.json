{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/security-continuous-receipt.schema.json",
  "title": "SecurityContinuousReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
        "schema_version",
        "package_id",
        "compat_snapshot_id",
        "receipt_id",
        "findings_count",
        "matched_content_logged",
        "status",
        "authority",
        "truth_boundary",
        "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-SEC-001" },
    "compat_snapshot_id": { "type": "string", "minLength": 1 },

    "receipt_id": { "type": "string" },
    "findings_count": { "type": "integer", "minimum": 0 },
    "matched_content_logged": { "const": false },
    "status": { "type": "string", "enum": ["clean", "findings", "error"] },

    "authority": {
      "type": "object",
      "required": ["level", "note"],
      "additionalProperties": false,
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": { "type": "string" },
    "generated": {
      "type": "object",
      "required": ["by"],
      "additionalProperties": false,
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
