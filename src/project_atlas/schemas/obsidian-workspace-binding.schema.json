{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/obsidian-workspace-binding.schema.json",
  "title": "ObsidianWorkspaceBinding",
  "type": "object",
  "additionalProperties": false,
  "required": [
        "schema_version",
        "package_id",
        "compat_snapshot_id",
        "binding_id",
        "plugin_shipped",
        "canonical_writes",
        "lens_ids",
        "authority",
        "truth_boundary",
        "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-OBS-UX-002" },
    "compat_snapshot_id": { "type": "string", "minLength": 1 },

    "binding_id": { "type": "string" },
    "plugin_shipped": { "const": false },
    "canonical_writes": { "const": false },
    "lens_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },

    "authority": {
      "type": "object",
      "required": ["level", "note"],
      "additionalProperties": false,
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": { "type": "string" },
    "generated": {
      "type": "object",
      "required": ["by"],
      "additionalProperties": false,
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
