{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/provider-quarantine-envelope.schema.json",
  "title": "Provider Quarantine Envelope",
  "description": "AS-2.0-PROV-001 quarantine envelope for provider/model output prior to provenance validation. Never Layer B authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "compat_snapshot_id",
    "envelope_id",
    "adapter_id",
    "status",
    "secret_scan",
    "authority",
    "truth_boundary",
    "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-PROV-001" },
    "compat_snapshot_id": { "const": "atlas-1.0.0-compat" },
    "envelope_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "status": {
      "enum": ["quarantined", "rejected-secret", "rejected-disabled"]
    },
    "secret_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findings_count", "content_redacted"],
      "properties": {
        "findings_count": { "type": "integer", "minimum": 0 },
        "content_redacted": { "const": true },
        "finding_kinds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "payload_kind": {
      "type": "string",
      "enum": ["structured-json", "text", "unknown"]
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": {
      "const": "QUARANTINED PROVIDER OUTPUT ≠ AUTHORITY"
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
