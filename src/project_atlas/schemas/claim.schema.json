{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/claim.schema.json",
  "title": "Claim",
  "description": "A single evidence-backed statement. No claim without a traceable source: provenance must contain at least one reference (FR-007).",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "subject", "field", "value", "provenance", "verification"],
  "properties": {
    "schema_version": { "const": 2 },
    "claim_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "project_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "source_lineage_id": { "type": ["string", "null"], "pattern": "^sline-[A-Za-z0-9]+$" },
    "subject": {
      "type": "string",
      "minLength": 1,
      "description": "Legacy concept ID or AS-CORE-004 semantic subject serialization (<kind>:<key>). Does not widen global ID_PATTERN.",
      "anyOf": [
        { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        { "pattern": "^(?:project|wp|adr|doc|review|experiment|roadmap-item|evidence):[A-Za-z0-9][A-Za-z0-9._-]*$" }
      ]
    },
    "claim_type": { "type": "string", "enum": ["project-purpose", "architecture-statement", "setup-requirement", "runtime-dependency", "deployment-target", "test-validation-result", "roadmap-status", "work-package-status", "decision", "risk-blocker", "operational-instruction"] },
    "field": { "type": "string", "minLength": 1 },
    "value": { "type": "string", "minLength": 1 },
    "normalized_text": { "type": ["string", "null"], "minLength": 1 },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "provenance-reference.schema.json" }
    },
    "verification": {
      "type": "string",
      "enum": ["unreviewed", "pending-human-review", "verified", "rejected"]
    },
    "source_hashes": { "type": "array", "items": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" } },
    "authority": { "type": "string", "enum": ["primary", "maintained", "validated-execution", "generated", "inferred", "pending", "conflicting", "rejected"] },
    "confidence": { "type": "string", "enum": ["high", "medium", "low", "unknown"] },
    "lifecycle": { "type": "string", "enum": ["new", "unchanged", "updated", "superseded", "contradicted", "stale", "removed-source", "restored", "rejected"] },
    "extraction_method": { "type": "string", "minLength": 1 },
    "predecessor_claim_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
  }
}
