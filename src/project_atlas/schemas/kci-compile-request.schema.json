{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/kci-compile-request.schema.json",
  "title": "KCI Compile Request",
  "description": "AS-2.0-KCI-001 consume-only knowledge compilation request. Not authority; 1.0 wins conflicts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "compat_snapshot_id",
    "request_id",
    "operation",
    "fixture_mode",
    "source_refs",
    "authority",
    "truth_boundary",
    "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-KCI-001" },
    "compat_snapshot_id": { "const": "atlas-1.0.0-compat" },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "operation": { "const": "compile" },
    "fixture_mode": { "type": "boolean" },
    "subject_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
      }
    },
    "notes": { "type": "string", "maxLength": 240 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": {
      "const": "KCI COMPILE ≠ AUTHORITY / ≠ SILENT WINNER"
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
