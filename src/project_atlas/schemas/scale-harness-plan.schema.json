{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/scale-harness-plan.schema.json",
  "title": "ScaleHarnessPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
        "schema_version",
        "package_id",
        "compat_snapshot_id",
        "plan_id",
        "live_load",
        "targets",
        "authority",
        "truth_boundary",
        "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.0-SCALE-001" },
    "compat_snapshot_id": { "type": "string", "minLength": 1 },

    "plan_id": { "type": "string" },
    "live_load": { "const": false },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "metric", "budget"],
        "properties": {
          "target_id": { "type": "string" },
          "metric": {
            "type": "string",
            "enum": ["files", "claims", "indexes", "latency-ms"]
          },
          "budget": { "type": "integer", "minimum": 1 }
        }
      }
    },

    "authority": {
      "type": "object",
      "required": ["level", "note"],
      "additionalProperties": false,
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": { "type": "string" },
    "generated": {
      "type": "object",
      "required": ["by"],
      "additionalProperties": false,
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
