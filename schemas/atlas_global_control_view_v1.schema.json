{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATLAS_GLOBAL_CONTROL_VIEW_V1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at_utc",
    "repository",
    "view_fingerprint",
    "honesty",
    "panels",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "ATLAS_GLOBAL_CONTROL_VIEW_V1"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "agent": {
      "type": ["string", "null"]
    },
    "agent_status": {
      "type": "string"
    },
    "view_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "honesty": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "control_view_ne_authority",
        "ui_ne_canonical_truth",
        "grants_no_write_claim_dispatch_merge_iv",
        "aggregates_live_dag_only"
      ],
      "properties": {
        "control_view_ne_authority": {
          "const": true
        },
        "ui_ne_canonical_truth": {
          "const": true
        },
        "grants_no_write_claim_dispatch_merge_iv": {
          "const": true
        },
        "aggregates_live_dag_only": {
          "const": true
        }
      }
    },
    "panels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agents",
        "ownership",
        "stacks",
        "frontier",
        "residuals",
        "telemetry",
        "steal",
        "dispatch_gates",
        "evidence_health",
        "postmerge",
        "event_bus",
        "system_honesty"
      ],
      "properties": {
        "agents": { "$ref": "#/$defs/panel" },
        "ownership": { "$ref": "#/$defs/panel" },
        "stacks": { "$ref": "#/$defs/panel" },
        "frontier": { "$ref": "#/$defs/panel" },
        "residuals": { "$ref": "#/$defs/panel" },
        "telemetry": { "$ref": "#/$defs/panel" },
        "steal": { "$ref": "#/$defs/panel" },
        "dispatch_gates": { "$ref": "#/$defs/panel" },
        "evidence_health": { "$ref": "#/$defs/panel" },
        "postmerge": { "$ref": "#/$defs/panel" },
        "event_bus": { "$ref": "#/$defs/panel" },
        "system_honesty": { "$ref": "#/$defs/panel" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "generator",
        "control_view_ne_authority",
        "ui_ne_canonical_truth",
        "grants_no_write_claim_dispatch_merge_iv",
        "aggregates_live_dag_only"
      ],
      "properties": {
        "generator": {
          "type": "string"
        },
        "control_view_ne_authority": {
          "const": true
        },
        "ui_ne_canonical_truth": {
          "const": true
        },
        "grants_no_write_claim_dispatch_merge_iv": {
          "const": true
        },
        "aggregates_live_dag_only": {
          "const": true
        },
        "seal_scan": {
          "type": "string"
        },
        "seal_projection": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "truth_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "presentation_only": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "panel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "summary"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["OK", "DEGRADED", "UNKNOWN"]
        },
        "summary": {
          "type": "object",
          "additionalProperties": true
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
