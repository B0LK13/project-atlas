{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATLAS_E2E_HARDENING_V1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at_utc",
    "repository",
    "hardening_fingerprint",
    "honesty",
    "scenarios",
    "invariants",
    "overall_status",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "ATLAS_E2E_HARDENING_V1"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "hardening_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "honesty": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "e2e_ne_authority",
        "no_self_iv",
        "no_fabricated_evidence"
      ],
      "properties": {
        "e2e_ne_authority": {
          "const": true
        },
        "no_self_iv": {
          "const": true
        },
        "no_fabricated_evidence": {
          "const": true
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "status", "evidence", "notes"],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["PASS", "FAIL", "SKIP"]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "required": [
        "AGENT_ROUTING",
        "OWNERSHIP",
        "CI_IV",
        "EVIDENCE_REUSE",
        "HANDOFFS",
        "POSTMERGE_SEALING",
        "FRONTIER_SELECTION",
        "CROSS_AGENT_UTILIZATION",
        "RESIDUAL_WORK",
        "COORDINATION_TELEMETRY",
        "GLOBAL_CONTROL_VIEW",
        "END_TO_E2E_HARDENING",
        "ATLAS_AUTONOMOUS_COORDINATION_STACK"
      ],
      "properties": {
        "AGENT_ROUTING": { "type": "boolean" },
        "OWNERSHIP": { "type": "boolean" },
        "CI_IV": { "type": "boolean" },
        "EVIDENCE_REUSE": { "type": "boolean" },
        "HANDOFFS": { "type": "boolean" },
        "POSTMERGE_SEALING": { "type": "boolean" },
        "FRONTIER_SELECTION": { "type": "boolean" },
        "CROSS_AGENT_UTILIZATION": { "type": "boolean" },
        "RESIDUAL_WORK": { "type": "boolean" },
        "COORDINATION_TELEMETRY": { "type": "boolean" },
        "GLOBAL_CONTROL_VIEW": { "type": "boolean" },
        "END_TO_E2E_HARDENING": { "type": "boolean" },
        "ATLAS_AUTONOMOUS_COORDINATION_STACK": { "type": "boolean" }
      }
    },
    "overall_status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "DEGRADED", "UNKNOWN"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "generator",
        "e2e_ne_authority",
        "fixture_driven",
        "grants_no_write_claim_dispatch_merge_iv"
      ],
      "properties": {
        "generator": {
          "type": "string"
        },
        "e2e_ne_authority": {
          "const": true
        },
        "fixture_driven": {
          "type": "boolean"
        },
        "grants_no_write_claim_dispatch_merge_iv": {
          "const": true
        },
        "mode": {
          "type": "string",
          "enum": ["fixture", "live", "mixed"]
        },
        "live_soft_failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
