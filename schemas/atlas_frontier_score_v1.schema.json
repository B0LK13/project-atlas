{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATLAS_FRONTIER_SCORE_V1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "weights_id",
    "weights_version",
    "agent",
    "ranked",
    "blocked",
    "ranking_fingerprint",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "ATLAS_FRONTIER_SCORE_V1"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "weights_id": {
      "type": "string",
      "minLength": 1
    },
    "weights_version": {
      "type": "integer",
      "minimum": 1
    },
    "agent": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_status": {
      "type": "string"
    },
    "ranked": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scored_entry"
      }
    },
    "blocked": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocked_entry"
      }
    },
    "ranking_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "generator",
        "authorization_before_scoring",
        "priority_is_not_authority"
      ],
      "properties": {
        "generator": {
          "type": "string"
        },
        "authorization_before_scoring": {
          "const": true
        },
        "priority_is_not_authority": {
          "const": true
        },
        "truth_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "factor_contrib": {
      "type": "object",
      "required": [
        "raw",
        "weight",
        "weighted",
        "rationale"
      ],
      "properties": {
        "raw": {
          "type": "number"
        },
        "weight": {
          "type": "number"
        },
        "weighted": {
          "type": "number"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "scored_entry": {
      "type": "object",
      "required": [
        "pr",
        "lane",
        "action_class",
        "executable",
        "total",
        "factors",
        "tiebreak_key",
        "authorization"
      ],
      "properties": {
        "pr": {
          "type": "integer",
          "minimum": 1
        },
        "lane": {
          "type": "string"
        },
        "action_class": {
          "type": "string",
          "enum": [
            "RUNNABLE_WRITE",
            "RUNNABLE_READONLY"
          ]
        },
        "executable": {
          "const": true
        },
        "total": {
          "type": "number"
        },
        "factors": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/factor_contrib"
          }
        },
        "tiebreak_key": {
          "type": "array"
        },
        "authorization": {
          "type": "object",
          "required": [
            "routable",
            "action_class",
            "reasons",
            "blockers"
          ],
          "properties": {
            "routable": {
              "const": true
            },
            "action_class": {
              "type": "string"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "blockers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "blocked_entry": {
      "type": "object",
      "required": [
        "pr",
        "lane",
        "action_class",
        "executable",
        "nominal_total",
        "factors",
        "authorization"
      ],
      "properties": {
        "pr": {
          "type": "integer",
          "minimum": 1
        },
        "lane": {
          "type": "string"
        },
        "action_class": {
          "const": "BLOCKED"
        },
        "executable": {
          "const": false
        },
        "nominal_total": {
          "type": "number"
        },
        "factors": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/factor_contrib"
          }
        },
        "authorization": {
          "type": "object",
          "required": [
            "routable",
            "action_class",
            "reasons",
            "blockers"
          ],
          "properties": {
            "routable": {
              "const": false
            },
            "action_class": {
              "type": "string"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "blockers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ranked": {
            "type": "array",
            "minItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "ranked": {
            "items": {
              "properties": {
                "executable": {
                  "const": true
                }
              }
            }
          }
        }
      }
    }
  ]
}
