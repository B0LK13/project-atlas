{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATLAS_COORDINATION_TELEMETRY_V1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "generated_at_utc",
    "repository",
    "truth_fingerprint",
    "telemetry_fingerprint",
    "honesty",
    "categories",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "ATLAS_COORDINATION_TELEMETRY_V1"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "agent": {
      "type": ["string", "null"]
    },
    "agent_status": {
      "type": "string"
    },
    "truth_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "telemetry_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "honesty": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "telemetry_ne_authority",
        "metrics_ne_authorization",
        "derived_from_live_dag_only",
        "grants_no_write_claim_dispatch_merge_iv"
      ],
      "properties": {
        "telemetry_ne_authority": {
          "const": true
        },
        "metrics_ne_authorization": {
          "const": true
        },
        "derived_from_live_dag_only": {
          "const": true
        },
        "grants_no_write_claim_dispatch_merge_iv": {
          "const": true
        }
      }
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "notes", "metrics"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["OK", "DEGRADED", "UNKNOWN"]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metrics": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "generator",
        "telemetry_ne_authority",
        "metrics_ne_authorization",
        "derived_from_live_dag_only",
        "grants_no_write_claim_dispatch_merge_iv"
      ],
      "properties": {
        "generator": {
          "type": "string"
        },
        "telemetry_ne_authority": {
          "const": true
        },
        "metrics_ne_authorization": {
          "const": true
        },
        "derived_from_live_dag_only": {
          "const": true
        },
        "grants_no_write_claim_dispatch_merge_iv": {
          "const": true
        },
        "seal_projection": {
          "type": "string"
        },
        "truth_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
