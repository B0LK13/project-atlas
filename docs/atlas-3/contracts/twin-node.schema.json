{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/atlas3/twin-node.schema.json",
  "title": "Atlas3TwinNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "package",
    "node_type",
    "node_id",
    "project_id",
    "evidence_refs",
    "authority",
    "temporal"
  ],
  "properties": {
    "schema": { "const": "atlas3.twin-node.v1" },
    "schema_version": { "const": 1 },
    "package": { "const": "AT3-002" },
    "node_type": {
      "enum": [
        "project",
        "repository",
        "component",
        "service",
        "file",
        "symbol",
        "claim",
        "decision",
        "requirement",
        "task",
        "agent",
        "pr",
        "commit",
        "test",
        "build",
        "deployment",
        "incident",
        "artifact",
        "environment"
      ]
    },
    "node_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "authority": { "const": "derived" },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["VALID_FROM", "VALID_TO", "OBSERVED_AT", "RECORDED_AT"],
      "properties": {
        "VALID_FROM": { "type": ["string", "null"] },
        "VALID_TO": { "type": ["string", "null"] },
        "OBSERVED_AT": { "type": ["string", "null"] },
        "RECORDED_AT": { "type": ["string", "null"] }
      }
    },
    "second_temporal_engine": { "const": false },
    "honesty": { "type": "object" }
  }
}
