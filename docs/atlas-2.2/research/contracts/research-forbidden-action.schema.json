{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/prep/atlas-2.2/research-forbidden-action.schema.json",
  "title": "research-forbidden-action (PREP STUB — not package data)",
  "description": "AS-2.2-RESEARCH-DEEPEN-PREP-001 fail-closed action proposal. Reject hypothesis promotion, silent conflict winners, LLM authority stamps, evidence-class mismatch, and canonical writes via pack.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "action_id",
    "kind",
    "status",
    "authority",
    "truth_boundary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.2-RESEARCH-DEEPEN-PREP-001" },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "question_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "enum": [
        "hypothesis_promotion",
        "silent_conflict_winner",
        "llm_authority_stamp",
        "evidence_class_mismatch",
        "canonical_write_via_pack",
        "estate_fact_invent"
      ]
    },
    "status": {
      "enum": ["accepted", "rejected_malformed", "rejected_forbidden"]
    },
    "expected_error": {
      "type": ["string", "null"],
      "enum": [
        null,
        "research-hypothesis-promotion-forbidden",
        "research-silent-winner-forbidden",
        "research-llm-authority-forbidden",
        "research-class-mismatch-forbidden",
        "research-canonical-write-forbidden",
        "research-estate-fact-invent-forbidden"
      ]
    },
    "authority_promoted": { "const": false },
    "canonical_writes": { "type": "boolean" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string", "maxLength": 400 }
      }
    },
    "truth_boundary": {
      "const": "RESEARCH ACTION ≠ LAYER B / ≠ SILENT WINNER / ≠ LLM AUTHORITY"
    },
    "_prep_note": { "type": "string" }
  }
}
