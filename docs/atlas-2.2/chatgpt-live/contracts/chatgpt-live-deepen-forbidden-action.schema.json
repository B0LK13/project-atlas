{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/prep/atlas-2.2/chatgpt-live-deepen-forbidden-action.schema.json",
  "title": "chatgpt-live-deepen-forbidden-action (PREP STUB — not package data)",
  "description": "AS-2.2-CHATGPT-LIVE-DEEPEN-PREP-001 fail-closed action vocabulary. Rejects env force-live, billing without opt-in, quarantine bypass, and release-cert stamps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "action_id",
    "kind",
    "status",
    "authority",
    "truth_boundary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.2-CHATGPT-LIVE-DEEPEN-PREP-001" },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "kind": {
      "enum": [
        "env_force_live",
        "billing_without_opt_in",
        "bypass_quarantine",
        "release_cert_stamp"
      ]
    },
    "status": {
      "enum": ["accepted", "rejected_malformed", "rejected_forbidden"]
    },
    "expected_error": {
      "type": ["string", "null"],
      "enum": [
        null,
        "chatgpt-live-env-force-live-forbidden",
        "chatgpt-live-billing-without-opt-in-forbidden",
        "chatgpt-live-bypass-quarantine-forbidden",
        "chatgpt-live-release-cert-stamp-forbidden"
      ]
    },
    "pilot_roots": { "const": 0 },
    "invent_pilot_roots": { "const": false },
    "canonical_writes": { "type": "boolean" },
    "opt_in": { "type": "boolean" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string", "maxLength": 400 }
      }
    },
    "truth_boundary": {
      "const": "CHATGPT LIVE DEEPEN ≠ ENV FORCE / ≠ BILLING WITHOUT OPT-IN / ≠ BYPASS QUARANTINE / ≠ RELEASE CERT"
    },
    "_prep_note": { "type": "string" }
  }
}
