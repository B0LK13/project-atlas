{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/prep/atlas-2.2/chatgpt-live-forbidden-action.schema.json",
  "title": "forbidden-action (PREP STUB — not package data)",
  "description": "AS-2.2-CHATGPT-LIVE-PREP-001 fail-closed action vocabulary. Rejects quarantine bypass, Layer B writes, LLM authority, default-on live, and PILOT invent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "action_id",
    "kind",
    "status",
    "authority",
    "truth_boundary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.2-CHATGPT-LIVE-PREP-001" },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "kind": {
      "enum": [
        "bypass_quarantine",
        "layer_b_write",
        "llm_authority_stamp",
        "default_on_live",
        "pilot_invent",
        "chatgpt_bridge_mutate",
        "missing_env_credential",
        "billing_blocked"
      ]
    },
    "status": {
      "enum": ["accepted", "rejected_malformed", "rejected_forbidden"]
    },
    "expected_error": {
      "type": ["string", "null"],
      "enum": [
        null,
        "chatgpt-live-bypass-quarantine-forbidden",
        "chatgpt-live-layer-b-write-forbidden",
        "chatgpt-live-llm-authority-forbidden",
        "chatgpt-live-default-on-forbidden",
        "chatgpt-live-pilot-invent-forbidden",
        "chatgpt-live-bridge-mutate-forbidden",
        "chatgpt-live-missing-env-forbidden",
        "chatgpt-live-billing-blocked-forbidden"
      ]
    },
    "env_var_name": {
      "type": "string",
      "enum": ["OPENAI_API_KEY", "OPENAI_ORG_ID", "OPENAI_PROJECT_ID"]
    },
    "env_present": { "type": "boolean" },
    "billing_gate": {
      "type": "string",
      "enum": ["spending_limit", "quota_exceeded", "billing_disabled"]
    },
    "network_call_attempted": { "type": "boolean" },
    "canonical_writes": { "type": "boolean" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string", "maxLength": 400 }
      }
    },
    "truth_boundary": {
      "const": "CHATGPT LIVE ACTION ≠ BYPASS / ≠ LAYER B / ≠ AUTHORITY / ≠ PILOT"
    },
    "_prep_note": { "type": "string" }
  }
}
