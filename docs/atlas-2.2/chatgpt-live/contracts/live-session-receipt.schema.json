{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/prep/atlas-2.2/live-session-receipt.schema.json",
  "title": "live-session-receipt (PREP STUB — not package data)",
  "description": "AS-2.2-CHATGPT-LIVE-PREP-001 derived live session receipt. Requires quarantine ref; never Layer B; LLM≠authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "compat_snapshot_id",
    "session_id",
    "request_id",
    "live_chatgpt_api",
    "llm_authority",
    "canonical_write",
    "bypass_quarantine",
    "quarantine",
    "turn_count",
    "status",
    "authority",
    "truth_boundary",
    "evidence_class",
    "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.2-CHATGPT-LIVE-PREP-001" },
    "compat_snapshot_id": { "const": "atlas-1.0.0-compat" },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "live_chatgpt_api": { "type": "boolean" },
    "llm_authority": { "const": false },
    "canonical_write": { "const": false },
    "bypass_quarantine": { "const": false },
    "chatgpt_bridge_mutated": { "const": false },
    "quarantine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_id", "status"],
      "properties": {
        "envelope_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "status": {
          "enum": ["quarantined", "rejected-secret", "rejected-disabled"]
        }
      }
    },
    "turn_count": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": ["quarantined", "rejected_forbidden", "rejected_malformed", "rejected_disabled"]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string", "maxLength": 400 }
      }
    },
    "truth_boundary": {
      "const": "CHATGPT LIVE ≠ BYPASS QUARANTINE / ≠ LAYER B / ≠ AUTHORITY / LLM≠AUTHORITY"
    },
    "evidence_class": { "const": "fixture-only" },
    "pilot_roots": { "const": 0 },
    "authentic_estate": { "const": false },
    "atlas_2_1_release_certified": { "const": false },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": {
        "by": { "const": "project-atlas" }
      }
    },
    "_prep_note": { "type": "string" }
  }
}
