{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/prep/atlas-2.2/live-transcript.schema.json",
  "title": "live-transcript (PREP STUB — not package data)",
  "description": "AS-2.2-CHATGPT-LIVE-PREP-001 synthetic live ChatGPT transcript sketch. No secrets, no network calls, no real API keys.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "session_id",
    "turn_count",
    "turns",
    "authority",
    "truth_boundary",
    "evidence_class",
    "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.2-CHATGPT-LIVE-PREP-001" },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "turn_count": { "type": "integer", "minimum": 1 },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["turn_id", "role", "text", "synthetic"],
        "properties": {
          "turn_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "role": { "enum": ["user", "assistant", "system"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "synthetic": { "const": true }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string", "maxLength": 400 }
      }
    },
    "truth_boundary": {
      "const": "LIVE TRANSCRIPT ≠ AUTHORITY / LLM≠AUTHORITY / FIXTURE ONLY"
    },
    "evidence_class": { "const": "fixture-only" },
    "pilot_roots": { "const": 0 },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": {
        "by": { "const": "project-atlas" }
      }
    },
    "_prep_note": { "type": "string" }
  }
}
