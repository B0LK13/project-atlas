{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/prep/atlas-2.2/live-bridge-request.schema.json",
  "title": "live-bridge-request (PREP STUB — not package data)",
  "description": "AS-2.2-CHATGPT-LIVE-PREP-001 opt-in live ChatGPT bridge request. Default path remains export-only; live requires explicit opt_in.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "compat_snapshot_id",
    "request_id",
    "session_id",
    "opt_in",
    "live_chatgpt_api",
    "status",
    "authority",
    "truth_boundary",
    "evidence_class",
    "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.2-CHATGPT-LIVE-PREP-001" },
    "compat_snapshot_id": { "const": "atlas-1.0.0-compat" },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "opt_in": { "type": "boolean" },
    "live_chatgpt_api": { "type": "boolean" },
    "export_bridge_default": { "const": true },
    "status": {
      "enum": ["accepted_opt_in", "rejected_disabled", "rejected_malformed"]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string", "maxLength": 400 }
      }
    },
    "truth_boundary": {
      "const": "LIVE BRIDGE REQUEST ≠ DEFAULT-ON / ≠ LAYER B / ≠ AUTHORITY"
    },
    "evidence_class": { "const": "fixture-only" },
    "pilot_roots": { "const": 0 },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": {
        "by": { "const": "project-atlas" }
      }
    },
    "_prep_note": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "opt_in": { "const": true } },
        "required": ["opt_in"]
      },
      "then": {
        "properties": {
          "live_chatgpt_api": { "const": true },
          "status": { "const": "accepted_opt_in" }
        }
      }
    },
    {
      "if": {
        "properties": { "opt_in": { "const": false } },
        "required": ["opt_in"]
      },
      "then": {
        "properties": {
          "live_chatgpt_api": { "const": false },
          "status": { "enum": ["rejected_disabled", "rejected_malformed"] }
        }
      }
    }
  ]
}
