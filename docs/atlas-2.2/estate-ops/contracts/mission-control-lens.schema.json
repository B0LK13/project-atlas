{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/prep/atlas-2.2/mission-control-lens.schema.json",
  "title": "mission-control-lens (PREP STUB — not package data)",
  "description": "AS-2.2-ESTATE-OPS-PREP-001 Mission Control lens card. Read-only queue projection; UI≠canonical.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "lens_id",
    "lens_kind",
    "project_id",
    "status",
    "queue_chips",
    "authority",
    "truth_boundary",
    "evidence_class",
    "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.2-ESTATE-OPS-PREP-001" },
    "lens_id": {
      "type": "string",
      "pattern": "^mclens-[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "lens_kind": { "const": "mission-control" },
    "project_id": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["ok", "partial", "unknown", "empty", "rejected_malformed"]
    },
    "queue_chips": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chip_id", "label", "state"],
        "properties": {
          "chip_id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "maxLength": 120 },
          "state": { "enum": ["open", "blocked", "unknown", "done"] },
          "evidence_ref": { "type": "string" }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string", "maxLength": 400 }
      }
    },
    "truth_boundary": {
      "const": "MISSION CONTROL LENS ≠ CANONICAL WRITE / ≠ AUTHORITY"
    },
    "evidence_class": { "const": "fixture-only" },
    "pilot_roots": { "const": 0 },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": { "by": { "const": "project-atlas" } }
    },
    "_prep_note": { "type": "string" }
  }
}
