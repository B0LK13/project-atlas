{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/prep/atlas-2.2/reality-gap-forbidden-action.schema.json",
  "title": "reality-gap-forbidden-action (PREP STUB — not package data)",
  "description": "AS-2.2-REALITY-GAP-DEEPEN-PREP-001 fail-closed action proposal. Reject unknown_as_healthy, ui_canonical_write, release_cert_stamp, unlock_stamp, pilot_invent, runtime_mutation, llm_authority_stamp.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "action_id",
    "kind",
    "status",
    "authority",
    "truth_boundary",
    "evidence_class",
    "authentic_estate",
    "release_certified",
    "pilot_pass",
    "canonical_writes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package_id": {
      "const": "AS-2.2-REALITY-GAP-DEEPEN-PREP-001"
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "kind": {
      "enum": [
        "unknown_as_healthy",
        "ui_canonical_write",
        "release_cert_stamp",
        "unlock_stamp",
        "pilot_invent",
        "runtime_mutation",
        "llm_authority_stamp"
      ]
    },
    "status": {
      "const": "rejected_forbidden"
    },
    "expected_error": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "reality-gap-unknown-as-healthy-forbidden",
        "reality-gap-ui-canonical-write-forbidden",
        "reality-gap-release-cert-stamp-forbidden",
        "reality-gap-unlock-stamp-forbidden",
        "reality-gap-pilot-invent-forbidden",
        "reality-gap-runtime-mutation-forbidden",
        "reality-gap-llm-authority-forbidden"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "const": "derived"
        },
        "note": {
          "type": "string",
          "maxLength": 400
        }
      }
    },
    "evidence_class": {
      "const": "fixture-only"
    },
    "authentic_estate": {
      "const": false
    },
    "release_certified": {
      "const": false
    },
    "pilot_pass": {
      "const": false
    },
    "canonical_writes": {
      "const": false
    },
    "pilot_roots": {
      "const": 0
    },
    "truth_boundary": {
      "const": "REALITY GAP PREP ≠ RELEASE CERT / ≠ UNLOCK / ≠ PILOT / ≠ UNKNOWN-AS-HEALTHY / ≠ UI CANONICAL / ≠ LLM AUTHORITY"
    },
    "_prep_note": {
      "type": "string"
    }
  }
}
