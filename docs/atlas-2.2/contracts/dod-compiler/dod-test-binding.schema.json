{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/prep/atlas-2.2/dod-test-binding.schema.json",
  "title": "dod-test-binding (PREP STUB — not package data)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "binding_id", "criterion_id", "kind", "locator"],
  "properties": {
    "schema": { "const": "atlas.dod.test_binding.v0" },
    "binding_id": { "type": "string", "minLength": 3, "maxLength": 128 },
    "criterion_id": { "type": "string", "minLength": 3, "maxLength": 128 },
    "kind": {
      "type": "string",
      "enum": ["pytest", "adv_row", "manual_procedure", "ci_job"]
    },
    "locator": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "description": "Node id, test path, ADV row id, or job name — relative, no host roots"
    },
    "expects": {
      "type": "string",
      "enum": ["pass", "fail_closed", "skip_forbidden"]
    }
  }
}
