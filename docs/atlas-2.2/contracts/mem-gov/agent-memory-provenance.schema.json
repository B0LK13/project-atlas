{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/prep/atlas-2.2/agent-memory-provenance.schema.json",
  "title": "agent-memory-provenance (PREP STUB — not package data)",
  "description": "AS-2.2-MEM-GOV-001 mandatory provenance block. Never Layer B authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_sha256",
    "source_receipt_id",
    "session_id"
  ],
  "properties": {
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "vault_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "normalized_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
