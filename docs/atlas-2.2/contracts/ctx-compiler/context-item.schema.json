{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/schemas/drafts/atlas-2.2/context-item.schema.json",
  "title": "ContextCompilerItemDraft",
  "description": "AS-2.2-CTX-COMPILER-001 PREP draft context item. Not production package data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id",
    "ref",
    "kind",
    "reason_included",
    "authority",
    "freshness",
    "conflict_state"
  ],
  "properties": {
    "item_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "kind": {
      "type": "string",
      "enum": ["source", "receipt", "index", "claim", "concept", "other"]
    },
    "reason_included": {
      "type": "string",
      "enum": [
        "task-match",
        "profile-prefer",
        "authority-primary",
        "authority-validated",
        "authority-maintained",
        "freshness-current",
        "conflict-sidecar",
        "budget-retained",
        "explicit-candidate"
      ]
    },
    "authority": {
      "type": "string",
      "enum": [
        "primary",
        "validated-execution",
        "maintained",
        "generated",
        "inferred",
        "pending",
        "conflicting",
        "rejected"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": ["fresh", "stale", "unknown"]
    },
    "conflict_state": {
      "type": "string",
      "enum": ["none", "unresolved", "excluded"]
    },
    "project_id": { "type": "string", "maxLength": 128 },
    "label": { "type": "string", "maxLength": 120 },
    "approx_bytes": { "type": "integer", "minimum": 0 }
  }
}
