{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/prep/atlas-2.2/research-question.schema.json",
  "title": "research-question (PREP STUB - not package data)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "question_id",
    "statement",
    "scope",
    "evidence_class",
    "authentic_estate"
  ],
  "properties": {
    "schema": { "const": "atlas.research.question.v0" },
    "question_id": { "type": "string", "minLength": 3, "maxLength": 128 },
    "statement": { "type": "string", "minLength": 3, "maxLength": 2048 },
    "scope": {
      "type": "string",
      "enum": ["project", "portfolio", "estate", "fixture"]
    },
    "project_id": { "type": "string" },
    "evidence_class": {
      "type": "string",
      "enum": [
        "fixture-only",
        "source_document",
        "claim_pointer",
        "receipt",
        "authentic_estate"
      ]
    },
    "authentic_estate": { "type": "boolean" },
    "notes": { "type": "string" }
  }
}
