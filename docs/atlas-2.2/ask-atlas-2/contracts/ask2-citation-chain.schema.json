{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/prep/atlas-2.2/ask2-citation-chain.schema.json",
  "title": "ask2-citation-chain (PREP STUB — not package data)",
  "description": "AS-2.2-ASK2-DEEPEN-PREP-001 citation chain. Structured evidence→hypothesis→pack nodes beyond flat EVIDENCE string lists.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "chain_id",
    "answer_id",
    "nodes",
    "authority",
    "truth_boundary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.2-ASK2-DEEPEN-PREP-001" },
    "chain_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "answer_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "role",
          "ref_id",
          "ordinal"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "role": {
            "enum": ["evidence", "hypothesis", "pack", "conflict"]
          },
          "ref_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "supports_answer": { "type": "boolean" },
          "note": { "type": "string", "maxLength": 400 }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string", "maxLength": 400 }
      }
    },
    "truth_boundary": {
      "const": "CITATION CHAIN ≠ AUTHORITY / ≠ TRUST SCORE"
    },
    "evidence_class": { "const": "fixture-only" },
    "_prep_note": { "type": "string" }
  }
}
