{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/prep/atlas-2.2/ask2-forbidden-action.schema.json",
  "title": "ask2-forbidden-action (PREP STUB — not package data)",
  "description": "AS-2.2-ASK2-DEEPEN-PREP-001 fail-closed action proposal. Reject live mutate, LLM authority stamps, and canonical writes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "action_id",
    "kind",
    "status",
    "authority",
    "truth_boundary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.2-ASK2-DEEPEN-PREP-001" },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "kind": {
      "enum": [
        "live_path_mutate",
        "llm_authority_stamp",
        "canonical_write",
        "replace_live_match",
        "trust_score_invent"
      ]
    },
    "status": {
      "enum": ["accepted", "rejected_malformed", "rejected_forbidden"]
    },
    "expected_error": {
      "type": ["string", "null"],
      "enum": [
        null,
        "ask2-live-mutate-forbidden",
        "ask2-llm-authority-forbidden",
        "ask2-canonical-write-forbidden",
        "ask2-replace-live-match-forbidden",
        "ask2-trust-score-forbidden"
      ]
    },
    "canonical_writes": { "type": "boolean" },
    "live_path_owned": { "const": false },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string", "maxLength": 400 }
      }
    },
    "truth_boundary": {
      "const": "ASK2 ACTION ≠ LIVE MUTATE / ≠ LAYER B WRITE / ≠ LLM AUTHORITY"
    },
    "_prep_note": { "type": "string" }
  }
}
