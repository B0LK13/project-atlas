{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/prep/atlas-2.2/ask2-deepen-answer-view.schema.json",
  "title": "ask2-deepen-answer-view (PREP STUB — not package data)",
  "description": "AS-2.2-ASK2-DEEPEN-PREP-001 deepen answer envelope. Extends research-ask2 8-field shape with citation chains and lens projections. UI≠canonical; Ask2≠live mutate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "answer_id",
    "question_id",
    "pack_id",
    "ANSWER",
    "WHY",
    "WHY_NOT",
    "EVIDENCE",
    "AUTHORITY",
    "TEMPORAL_VALIDITY",
    "CONFLICTS",
    "UNKNOWN",
    "citation_chain_id",
    "lenses",
    "canonical_write",
    "ui_truth",
    "graph_authority",
    "llm_authority",
    "live_path_owned",
    "authority",
    "truth_boundary",
    "evidence_class",
    "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.2-ASK2-DEEPEN-PREP-001" },
    "answer_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "question_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "pack_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "ANSWER": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "WHY": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 400 }
    },
    "WHY_NOT": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 400 }
    },
    "EVIDENCE": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "AUTHORITY": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["derived", "documentation", "execution", "manifest"]
        },
        "note": { "type": "string", "maxLength": 400 }
      }
    },
    "TEMPORAL_VALIDITY": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "valid_from": { "type": ["string", "null"] },
        "valid_to": { "type": ["string", "null"] },
        "as_of_known": { "type": "boolean" }
      }
    },
    "CONFLICTS": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "UNKNOWN": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 400 }
    },
    "citation_chain_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "lenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "projection_id"],
        "properties": {
          "surface": { "enum": ["web", "mcp", "cli"] },
          "projection_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        }
      }
    },
    "canonical_write": { "const": false },
    "ui_truth": { "const": false },
    "graph_authority": { "const": false },
    "llm_authority": { "const": false },
    "live_path_owned": { "const": false },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string", "maxLength": 400 }
      }
    },
    "truth_boundary": {
      "const": "ASK ATLAS 2 DEEPEN ≠ LIVE MUTATE / ≠ CANONICAL WRITE / ≠ AUTHORITY / UI ≠ TRUTH"
    },
    "evidence_class": { "const": "fixture-only" },
    "pilot_roots": { "const": 0 },
    "authentic_estate": { "const": false },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": {
        "by": { "const": "project-atlas" }
      }
    },
    "_prep_note": { "type": "string" }
  }
}
