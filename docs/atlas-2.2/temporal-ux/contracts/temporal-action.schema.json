{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/prep/atlas-2.2/temporal-action.schema.json",
  "title": "temporal-action (PREP STUB — not package data)",
  "description": "AS-2.2-TEMPORAL-UX-PREP-001 operator temporal action proposal. Fail-closed: reject wall_clock_as_of, silent_winner, bitemporal_mutation, UI canonical writes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "action_id",
    "kind",
    "status",
    "authority",
    "truth_boundary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.2-TEMPORAL-UX-PREP-001" },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "claim_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "kind": {
      "enum": [
        "open_evidence",
        "escalate_review",
        "request_human",
        "wall_clock_as_of",
        "silent_winner",
        "bitemporal_mutation",
        "ui_canonical_write"
      ]
    },
    "status": {
      "enum": ["accepted", "rejected_malformed", "rejected_forbidden"]
    },
    "expected_error": {
      "type": ["string", "null"],
      "enum": [
        null,
        "temporal-ux-wall-clock-forbidden",
        "temporal-ux-silent-winner-forbidden",
        "temporal-ux-bitemporal-mutation-forbidden",
        "temporal-ux-ui-canonical-write-forbidden"
      ]
    },
    "canonical_writes": { "type": "boolean" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string", "maxLength": 400 }
      }
    },
    "truth_boundary": {
      "const": "TEMPORAL ACTION ≠ WALL-CLOCK / ≠ SILENT WINNER / ≠ BITEMPORAL MUTATION / ≠ LAYER B WRITE"
    },
    "_prep_note": { "type": "string" }
  }
}
