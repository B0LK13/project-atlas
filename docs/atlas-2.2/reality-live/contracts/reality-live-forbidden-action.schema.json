{
  "$id": "https://project-atlas.local/prep/atlas-2.2/reality-live-forbidden-action.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "AS-2.2-REALITY-LIVE-DEEPEN-PREP-001 fail-closed action proposal. Reject PILOT invent, LLM authority stamps, conversational sole certifier, Layer B promotion, and release-cert stamps.",
  "properties": {
    "_prep_note": {
      "type": "string"
    },
    "action_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    },
    "authentic_estate": {
      "const": false
    },
    "authority": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "const": "derived"
        },
        "note": {
          "maxLength": 400,
          "type": "string"
        }
      },
      "required": [
        "level"
      ],
      "type": "object"
    },
    "canonical_writes": {
      "const": false
    },
    "evidence_class": {
      "const": "fixture-only"
    },
    "expected_error": {
      "enum": [
        null,
        "reality-live-pilot-invent-forbidden",
        "reality-live-llm-authority-forbidden",
        "reality-live-conversational-sole-certifier-forbidden",
        "reality-live-layer-b-promotion-forbidden",
        "reality-live-release-cert-stamp-forbidden"
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "invent_pilot_roots": {
      "const": false
    },
    "kind": {
      "enum": [
        "pilot_invent",
        "llm_authority_stamp",
        "conversational_sole_certifier",
        "layer_b_promotion",
        "release_cert_stamp"
      ]
    },
    "package_id": {
      "const": "AS-2.2-REALITY-LIVE-DEEPEN-PREP-001"
    },
    "pilot_roots": {
      "const": 0
    },
    "plane_id": {
      "enum": [
        "conversational",
        "documentary",
        "implementation",
        "operational",
        "aggregator"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "rejected_forbidden"
    },
    "truth_boundary": {
      "const": "REALITY-LIVE GAP REPORT \u2260 PILOT PASS / \u2260 WEB ACCEPTED / \u2260 RELEASE CERT / \u2260 Layer B"
    }
  },
  "required": [
    "action_id",
    "authentic_estate",
    "authority",
    "canonical_writes",
    "evidence_class",
    "kind",
    "package_id",
    "schema_version",
    "status",
    "truth_boundary"
  ],
  "title": "reality-live-forbidden-action (PREP STUB \u2014 not package data)",
  "type": "object"
}
