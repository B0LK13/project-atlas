{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/prep/atlas-2.2/xproj-estate-lens.schema.json",
  "title": "xproj-estate-lens (PREP STUB — not package data)",
  "description": "AS-2.2-XPROJ-CONTRACT-PREP-001 read-only estate lens. Consume-only; UI≠canonical; CROSS-PROJECT ≠ AUTHORITY.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "lens_id",
    "scope",
    "buckets",
    "cited_ids",
    "status",
    "authority",
    "truth_boundary",
    "evidence_class",
    "atlas_2_1_release_certified",
    "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.2-XPROJ-CONTRACT-PREP-001" },
    "lens_id": {
      "type": "string",
      "pattern": "^xlens-[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "project_ids"],
      "properties": {
        "kind": { "enum": ["estate-slice", "project-set"] },
        "project_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "buckets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "entities",
          "joins",
          "edges",
          "duplicate-candidates",
          "indexes",
          "conflicts"
        ]
      }
    },
    "cited_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "status": {
      "enum": ["selected", "partial", "quarantine", "rejected_malformed"]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": {
      "const": "XPROJ ESTATE LENS ≠ AUTHORITY / ≠ LAYER B MUTATION"
    },
    "evidence_class": { "const": "fixture-only" },
    "atlas_2_1_release_certified": { "const": false },
    "pilot_roots": { "const": 0 },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
