{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-atlas.local/prep/atlas-2.2/as-of-snapshot.schema.json",
  "title": "as-of-snapshot (PREP STUB — not package data)",
  "description": "AS-2.2-TIME-MACHINE-001 as-of snapshot. Prefer unresolved over wrong current. Never uses wall-clock now.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "compat_snapshot_id",
    "scope",
    "as_of_valid_time",
    "status",
    "claims",
    "unresolved",
    "authority",
    "truth_boundary",
    "evidence_class",
    "generated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "AS-2.2-TIME-MACHINE-001" },
    "compat_snapshot_id": { "const": "atlas-1.0.0-compat" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["project", "subject", "estate-slice"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "as_of_valid_time": { "type": "string", "minLength": 4, "maxLength": 64 },
    "knowledge_compilation_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "status": {
      "enum": [
        "selected",
        "partial",
        "not_found",
        "unresolved_overlap",
        "unresolved_incomplete",
        "rejected_malformed"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "field", "disposition"],
        "properties": {
          "subject": { "type": "string", "minLength": 1 },
          "field": { "type": "string", "minLength": 1 },
          "disposition": {
            "enum": ["selected", "historical", "unresolved", "authority_pending"]
          },
          "selected_claim_id": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "candidate_claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          }
        }
      }
    },
    "graph": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["entity_ids", "edge_ids"],
      "properties": {
        "entity_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "edge_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "disposition"],
        "properties": {
          "decision_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "disposition": {
            "enum": ["open", "accepted", "rejected", "deferred", "superseded"]
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "subject", "field"],
        "properties": {
          "reason": {
            "enum": [
              "unresolved_overlap",
              "unresolved_incomplete",
              "authority_pending",
              "rejected_malformed"
            ]
          },
          "subject": { "type": "string" },
          "field": { "type": "string" },
          "candidate_claim_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "const": "derived" },
        "note": { "type": "string" }
      }
    },
    "truth_boundary": {
      "const": "TIME MACHINE AS-OF ≠ AUTHORITY / ≠ WALL-CLOCK NOW"
    },
    "evidence_class": { "const": "fixture-only" },
    "pilot_roots": { "const": 0 },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": { "by": { "const": "project-atlas" } }
    }
  }
}
